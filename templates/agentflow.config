# Configuración de agentflow para este proyecto (sintaxis de shell).
# La lee .agentflow/bin/af. Este archivo es del proyecto: `af install` no lo sobrescribe.

# Rama de integración.
AF_BASE=main

# Carpeta de las tareas (PLAN, HANDOFF, REVIEW).
AF_TASKS_DIR=docs/agents/tasks

# Dónde se crean los worktrees de cada tarea, relativo a la raíz del repo.
# Con "..", la tarea "x" del repo "app" queda en ../app-x
AF_WORKTREE_ROOT=..

# Autor por defecto de las tareas nuevas (claude o codex). El revisor es el otro.
AF_DEFAULT_AUTHOR=claude

# Verificación determinista: lint + tests. Debe salir con 0 si todo está bien.
AF_CHECK_CMD="echo 'define AF_CHECK_CMD en .agentflow/config' && false"

# Foco adicional para el revisor (riesgos propios del proyecto).
AF_REVIEW_FOCUS=""

# Rondas de revisión antes de que los P0/P1 pendientes pasen a decisión del usuario.
AF_REVIEW_MAX_RONDAS=3

# Argumentos extra para `codex exec review` (por ejemplo: -m gpt-x -c model_reasoning_effort="high").
AF_CODEX_REVIEW_ARGS=""
