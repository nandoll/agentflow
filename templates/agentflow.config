# Configuración de agentflow para este proyecto (sintaxis de shell).
# La lee .agentflow/bin/af. Este archivo es del proyecto: `af install` no lo sobrescribe.

# Rama base desde la que se crean las tareas (puede ser remota, p. ej. origin/main).
AF_BASE=main

# Si es 1, las refs remotas se actualizan con git fetch: la base antes de ramificar
# (`af new-task`) y los destinos antes de decidir (`af clean`).
AF_FETCH_BASE=0

# Carpeta de las tareas (PLAN, HANDOFF, REVIEW).
AF_TASKS_DIR=docs/agents/tasks

# Modo local: 1 = la metodología no entra al repositorio (repos de equipo).
# Las rutas de AF_LOCAL_PATHS y AF_TASKS_DIR se excluyen en .git/info/exclude y
# cada worktree las ve por enlaces al checkout principal. Al repo solo llegan los cambios.
AF_LOCAL=0
AF_LOCAL_PATHS=".agentflow AGENTS.md CLAUDE.md .claude/settings.local.json"

# Nombre de las ramas. Vacío = esquema clásico: feat/<slug> (Claude) o codex/<slug> (Codex).
# Con plantilla, la rama no depende del autor. Variables: {type} y {slug}.
# Ejemplo: AF_BRANCH_TEMPLATE="{type}/{slug}" con `af new-task SD2-123-login --type fix`.
AF_BRANCH_TEMPLATE=""
AF_BRANCH_TYPE=feature

# Dónde se crean los worktrees de cada tarea, relativo a la raíz del repo.
# Con "..", la tarea "x" del repo "app" queda en ../app-x
AF_WORKTREE_ROOT=..

# Comando que prepara cada worktree nuevo (dependencias, etc.). Vacío = nada.
AF_WORKTREE_SETUP=""

# Autor por defecto de las tareas nuevas (claude o codex). El revisor es el otro.
AF_DEFAULT_AUTHOR=claude

# Verificación determinista: lint + tests. Debe salir con 0 si todo está bien.
AF_CHECK_CMD="echo 'define AF_CHECK_CMD en .agentflow/config' && false"

# Foco adicional para el revisor (riesgos propios del proyecto).
AF_REVIEW_FOCUS=""

# Rondas de revisión antes de que los P0/P1 pendientes pasen a decisión del usuario.
AF_REVIEW_MAX_RONDAS=3

# Argumentos extra para `codex exec` en la revisión (por ejemplo: -m gpt-x -c model_reasoning_effort="high").
AF_CODEX_REVIEW_ARGS=""

# Ramas donde `af clean` busca la tarea integrada (detecta merges con squash). Vacío = su base.
AF_CLEAN_TARGETS=""

# Salidas regenerables que `af clean` puede borrar del worktree (globs, separados por espacio).
# Cualquier otro archivo ignorado detiene el clean: git lo borraría sin avisar.
# Ejemplo: AF_CLEAN_DISPOSABLE="node_modules .next dist"
AF_CLEAN_DISPOSABLE=""
